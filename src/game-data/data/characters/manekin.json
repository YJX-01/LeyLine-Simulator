  "passives": [
    {
      "id": "manekin.passive1",
      "name": "战域重划",
      "description": "奇偶离场时，如果场上存在奇偶自己创造的「禁限区域」，则「禁限区域」会发生爆炸，造成相当于奇偶攻击力200%的自身元素范围伤害。",
      "unlockAscension": 1
    },
    {
      "id": "manekin.passive2",
      "name": "交战持备",
      "description": "奇偶处于队伍后台时，若元素能量低于30%，每秒为自己恢复2点元素能量。",
      "unlockAscension": 4
    },
    {
      "id": "manekin.passive3",
      "name": "灵巧战姿",
      "description": "奇偶施放元素战技与元素爆发时，会从已有的装扮搭配方案中，随机选择一套进行切换。",
      "unlockAscension": 0
    }
