      "support": {
        "supported": false,
        "reason": "文本已收录，效果尚未核验。"
      }
    },
    {
      "id": "raidenshogun.passive2",
      "name": "殊胜之御体",
      "description": "基于元素充能效率超过100%的部分，每1%使雷电将军获得下列效果：\n·梦想一心状态提供的元素能量恢复提高0.6%；\n·雷元素伤害加成提升0.4%。",
      "unlockAscension": 4,
      "support": {
        "supported": false,
        "reason": "文本已收录，效果尚未核验。"
      }
    },
