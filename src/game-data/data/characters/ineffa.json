  "passives": [
    {
      "id": "ineffa.passive1",
      "name": "频率超限回路",
      "description": "若**「薇尔琪塔」**附近存在月感电反应产生的雷暴云，薇尔琪塔进行放电攻击时，将额外进行一次攻击，造成相当于伊涅芙攻击力65%的雷元素范围伤害，该伤害视为月感电反应造成的伤害。",
      "unlockAscension": 1
    },
    {
      "id": "ineffa.passive2",
      "name": "全相重构协议",
      "description": "施放元素爆发**至高律令·全域扫灭**时，将为队伍中自己的所有角色赋予「参数重构」效果：基于伊涅芙攻击力的6%，提升伊涅芙与队伍中自己当前场上角色的元素精通，持续20秒。",
      "unlockAscension": 4
    },
    {
      "id": "ineffa.passive3",
      "name": "月兆祝赐·象拟中继",
      "description": "队伍中的角色触发感电反应时，将转为触发月感电反应，且基于伊涅芙的攻击力，提升月感电反应的基础伤害：每100点攻击力都将提升0.7%基础伤害，至多通过这种方式提升14%伤害。\n\n此外，伊涅芙在队伍中时，队伍的月兆将会上升一级。",
      "unlockAscension": null,
      "buffs": [
