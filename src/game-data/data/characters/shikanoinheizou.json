  "passives": [
    {
      "id": "shikanoinheizou.passive1",
      "name": "反论稽古",
      "description": "鹿野院平藏在场上触发扩散、星扩散反应时，将获得1层勠心拳的「变格」效果，该效果每0.1秒至多触发一次。",
      "unlockAscension": 1
    },
    {
      "id": "shikanoinheizou.passive2",
      "name": "因由勘破",
      "description": "勠心拳命中敌人后，队伍中所有角色（不包括鹿野院平藏自己）的元素精通提升80点，持续10秒。",
      "unlockAscension": 4
    },
    {
      "id": "shikanoinheizou.passive3",
      "name": "在罪之先",
      "description": "队伍中自己的角色冲刺消耗的体力降低20%。\n无法与效果完全相同的固有天赋叠加。",
      "unlockAscension": null,
      "buffs": [
