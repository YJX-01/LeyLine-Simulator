  "passives": [
    {
      "id": "columbina.passive1",
      "name": "月亮诱发的疯狂",
      "description": "触发{LINK#N11250001}<color=#FFD780FF>引力干涉</color>{/LINK}时，哥伦比娅将获得月诱效果，使自身的暴击率提升5%，持续10秒。该效果至多叠加3层。",
      "unlockAscension": 1,
      "buffs": [
        {
          "id": "columbina.moon-temptation",
