83529d2592","path":"src/data/ChineseSimplified/artifacts/thundersoother.json"}},{"id":"tinymiracle","name":"奇迹","effects":[{"pieces":2,"modifiers":[],"support":{"supported":false,"reason":"效果未实现：所有元素抗性提高20%。"}},{"pieces":4,"modifiers":[],"support":{"supported":false,"reason":"效果未实现：受到某个元素类型的伤害后，相应的抗性提升30%，持续10秒。该效果每10秒只能触发一次。"}}],"source":{"repository":"theBowja/genshin-db","commit":"8e5badd60b5d894284ccc927a56c9683529d2592","path":"src/data/ChineseSimplified/artifacts/tinymiracle.json"}},{"id":"travelingdoctor","name":"游医","effects":[{"pieces":2,"modifiers":[{"stat":"healingBonus","values":[0.2]}],"support":{"supported":true,"reason":"角色受到的治疗效果提高20%。"}},{"pieces":4,"modifiers":[],"support":{"supported":false,"reason":"效果未实现：施放元素爆发时，恢复20%生命值。"}}],"source":{"repository":"theBowja/genshin-db","commit":"8e5badd60b5d894284ccc927a56c9683529d2592","path":"src/data/ChineseSimplified/artifacts/travelingdoctor.json"}},{"id":"unfinishedreverie","name":"未竟的遐思","effects":[{"pieces":2,"modifiers":[{"stat":"attackPercent","values":[0.18]}],"support":{"supported":true,"reason":"攻击力提高18%。"}},{"pieces":4,"modifiers":[],"support":{"supported":false,"reason":"效果未实现：脱离战斗状态3秒后，造成的伤害提升50%。在战斗状态下，附近不存在处于燃烧状态下的敌人超过6秒后，上述伤害提升效果每秒降低10%，直到降低至0%；存在处于燃烧状态下的敌人时，每秒提升10%，直到达到50%。装备此圣遗物套装的角色处于队伍后台时，依然会触发该效果。"}}],"source":{"repository":"theBowja/genshin-db","commit":"8e5badd60b5d894284ccc927a56c9683529d2592","path":"src/data/ChineseSimplified/artifacts/unfinishedreverie.json"}},{"id":"vermillionhereafter","name":"辰砂往生录","effects":[{"pieces":2,"modifiers":[{"stat":"attackPercent","values":[0.18]}],"support":{"supported":true,"reason":"攻击力提高18%。"}},{"pieces":4,"modifiers":[],"support":{"supported":false,"reason":"效果未实现：施放元素爆发后，将产生持续16秒的「潜光」效果：攻击力提升8%；并在角色的生命值降低时，攻击力进一步提升10%，至多通过这种方式提升4次，每0.8秒至多触发一次。「潜光」效果将在角色退场时消失；持续期间再次施放元素爆发，将移除原有的「潜光」。"}}],"source":{"repository":"theBowja/genshin-db","commit":"8e5badd60b5d894284ccc927a56c9683529d2592","path":"src/data/ChineseSimplified/artifacts/vermillionhereafter