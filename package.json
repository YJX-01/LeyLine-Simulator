{
  "name": "leyline-simulator",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "data:check": "node scripts/convert-repo-data.mjs --check",
    "fixture:check": "node scripts/create-team-example.mjs --check",
    "dev": "pnpm --filter @leyline/web dev",
    "build": "pnpm --filter @leyline/web build",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "perf:engine": "node --expose-gc scripts/benchmark-engine.mjs",
    "build:check": "node scripts/check-build.mjs",
    "build:subpath": "pnpm --filter @leyline/web build --base=/leyline/ --outDir=dist-subpath",
    "test:production": "playwright test --config playwright.production.config.ts",
    "preview": "node scripts/serve-dist.mjs",
    "release:prepare": "pnpm build && pnpm build:check && node scripts/prepare-release.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0"
  }
}
