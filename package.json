{
  "name": "leyline-simulator",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "data:check": "node scripts/convert-repo-data.mjs --check",
    "fixture:check": "node scripts/create-team-example.mjs --check",
    "dev": "pnpm --filter @leyline/web dev",
    "build": "pnpm --filter @leyline/web build",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0"
  }
}
