{
  "name": "leyline-simulator",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "clean:outputs": "node tools/scripts/dev/clean.mjs",
    "clean:cache": "node tools/scripts/dev/clean.mjs --cache",
    "architecture:check": "node tools/scripts/checks/check-architecture.mjs",
    "data:check": "node tools/scripts/checks/check-content-sources.mjs && node tools/scripts/data/build.mjs --check",
    "test:content": "node --test tests/integration/*.test.mjs",
    "test:content:desktop": "node tests/desktop/character-definition.mjs",
    "fixture:check": "node tools/scripts/checks/check-fixtures.mjs",
    "assets:check": "node tools/scripts/checks/check-ui-assets.mjs",
    "dev": "pnpm data:build && pnpm --filter @leyline/web dev",
    "desktop:build": "pnpm data:build && pnpm --filter @leyline/web build --base=./ --outDir=dist-desktop && node tools/scripts/build/package-desktop.mjs",
    "desktop:preview:build": "pnpm data:build && pnpm --filter @leyline/web build --base=./ --outDir=dist-desktop && node tools/scripts/build/package-desktop.mjs --preview",
    "desktop:start": "node tools/scripts/dev/start-desktop.mjs",
    "test:desktop": "node tests/desktop/workspace.mjs",
    "build": "pnpm data:build && pnpm --filter @leyline/web build",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p src/web/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ui": "playwright test tests/browser/development/inventory.spec.ts --project=chromium --workers=1",
    "test:ui:contracts": "playwright test tests/browser/development/ui-contracts.spec.ts --project=chromium --workers=1",
    "test:ui:desktop": "node tests/desktop/workspace.mjs",
    "perf:engine": "node --expose-gc tests/performance/timeline.mjs",
    "build:check": "node tools/scripts/checks/check-build.mjs",
    "build:subpath": "pnpm data:build && pnpm --filter @leyline/web build --base=/leyline/ --outDir=dist-subpath",
    "test:production": "playwright test --config playwright.production.config.ts",
    "preview": "node tools/scripts/dev/serve-dist.mjs",
    "release:prepare": "pnpm build && pnpm build:check && node tools/scripts/release/prepare-release.mjs",
    "release:verify": "node tools/scripts/release/verify-release.mjs",
    "licenses:capture": "node tools/scripts/licenses/third-party-notices.mjs --capture",
    "licenses:sync": "node tools/scripts/licenses/third-party-notices.mjs",
    "licenses:check": "node tools/scripts/licenses/third-party-notices.mjs --check",
    "data:build": "node tools/scripts/data/build.mjs",
    "docs:check": "node tools/scripts/checks/check-docs.mjs",
    "data:audit": "node tools/scripts/data/audit-numeric-sources.mjs",
    "data:capture": "node tools/scripts/data/capture-catalog.mjs",
    "data:prepare-characters": "python tools/scripts/data/prepare-character-update.py",
    "project:evaluate": "node tools/scripts/data/evaluate-project.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "electron": "^45.2.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0"
  }
}
