{
  "name": "leyline-simulator",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm data:build && pnpm --filter @leyline/web dev",
    "build": "pnpm data:build && pnpm --filter @leyline/web build",
    "preview": "node tools/scripts/dev/serve-dist.mjs",
    "desktop:build": "pnpm data:build && node tools/scripts/build/package-desktop.mjs",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p src/web/tsconfig.json",
    "test": "vitest run",
    "test:content": "node --test tests/integration/*.test.mjs",
    "test:e2e": "playwright test",
    "architecture:check": "node tools/scripts/checks/check-architecture.mjs",
    "data:build": "node tools/scripts/assets/build.mjs",
    "data:check": "node tools/scripts/checks/check-content-sources.mjs && node tools/scripts/assets/build.mjs --check && node tools/scripts/data/audit-calculation-coverage.mjs --check",
    "build:check": "node tools/scripts/checks/check-build.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "electron": "^45.2.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0"
  }
}
