{
  "name": "leyline-simulator",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "clean:outputs": "node tools/scripts/clean.mjs",
    "clean:cache": "node tools/scripts/clean.mjs --cache",
    "architecture:check": "node tools/scripts/check-architecture.mjs",
    "data:check": "node tools/scripts/convert-repo-data.mjs --check && node tools/scripts/convert-real-game-data.mjs --check",
    "fixture:check": "node tools/scripts/create-team-example.mjs --check",
    "assets:check": "node tools/scripts/check-ui-assets.mjs",
    "dev": "pnpm --filter @leyline/web dev",
    "desktop:build": "pnpm --filter @leyline/web build --base=./ --outDir=dist-desktop && node tools/scripts/package-desktop.mjs",
    "desktop:preview:build": "pnpm --filter @leyline/web build --base=./ --outDir=dist-desktop && node tools/scripts/package-desktop.mjs --preview",
    "desktop:start": "node tools/scripts/start-desktop.mjs",
    "test:desktop": "node tools/scripts/test-u1-desktop.mjs",
    "build": "pnpm --filter @leyline/web build",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p src/web/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ui": "playwright test tests/e2e/u1-inventory.spec.ts --project=chromium --workers=1",
    "test:ui:desktop": "node tools/scripts/test-u1-desktop.mjs",
    "perf:engine": "node --expose-gc tools/scripts/benchmark-engine.mjs",
    "build:check": "node tools/scripts/check-build.mjs",
    "build:subpath": "pnpm --filter @leyline/web build --base=/leyline/ --outDir=dist-subpath",
    "test:production": "playwright test --config playwright.production.config.ts",
    "preview": "node tools/scripts/serve-dist.mjs",
    "release:prepare": "pnpm build && pnpm build:check && node tools/scripts/prepare-release.mjs",
    "release:verify": "node tools/scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "electron": "^45.2.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0"
  }
}
