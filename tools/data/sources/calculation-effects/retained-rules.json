  "sourceNotes": {
    "beidou-stellar-conduct": {
      "character": "beidou",
      "scope": "Sixth constellation after Witch's Revelation, with Radiance: Stellar-Conduct explicitly confirmed.",
      "accessed": "2026-11-25",
      "sources": [
        {
          "url": "https://wiki.hoyolab.com/pc/genshin/entry/5654",
          "description": "HoYoWiki describes the sixth constellation's additional 15% Cryo resistance reduction on nearby opponents while Stormbreaker and Radiance: Stellar-Conduct are active."
        },
        {
          "url": "https://wiki.biligame.com/ys/%E5%8C%97%E6%96%97",
          "description": "The character entry records the 15% nearby Cryo resistance reduction and 200 elemental mastery for the current active character; it states that Beidou enters Radiance: Stellar-Conduct in a Polestar Field after unlocking the corresponding Witch's Revelation."
        },
        {
          "url": "https://gi.gachabase.net/characters/10000024/beidou/beta/6.6.54/45574465?lang=en",
          "description": "Versioned beta 6.6.54 revision 45574465 records the same sixth-constellation Cryo resistance and elemental mastery values; the current KQM and BWIKI character entries corroborate the released text."
        },
        {
          "url": "https://library.keqingmains.com/characters/electro/beidou",
          "description": "Current character text corroborates both the Radiance state and the two sixth-constellation effects."
        }
