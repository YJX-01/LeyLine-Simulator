  "probes": [
    {
      "id": "flins-direct-lunar",
      "monaInput": { "character": "Flins", "level": 90, "ascend": false, "constellation": 0, "skill1": 9, "skill2": 9, "skill3": 9, "params": { "talent1_active": true, "full_moon": true }, "weapon": "BeginnersProtector", "weaponLevel": 1, "refine": 1, "artifacts": [], "enemy": null, "buffs": [], "crit": "non_critical" },
      "leylineInput": { "character": "flins", "level": 90, "ascension": 6, "constellation": 0, "talentLevel": 10, "weapon": "beginnersprotector", "weaponLevel": 1, "refinement": 1, "artifacts": [], "enemyLevel": 90, "electroResistance": 0.1, "symphonyWindow": true, "fullMoonsign": true, "nearThundercloud": true },
      "equation": "attack * coefficient * 3 * 0.9 * (1 + 6 * mastery / (2000 + mastery) + 0.2) * (1 + attack * 0.00007), mastery = attack * 0.08",
      "rows": [
        { "monaIndex": 19, "leylineHit": "flins.burst.symphony", "coefficient": 1.286208, "mona": 1722.258786169951, "leyline": 1721.4521212310406 },
        { "monaIndex": 20, "leylineHit": "flins.burst.symphony-extra", "coefficient": 1.870848, "mona": 2505.054997019705, "leyline": 2503.930358154241 }
      ],
      "interpretation": "Mona uses rounded attack 375 and mastery 30, and rounds talent coefficients; LeyLine uses attack 374.8372196 and exact source coefficients. The extra strike is zero when nearThundercloud is false in LeyLine. Mona's menu index alone does not encode that explicit gate."
    },
    {
      "id": "flins-normal-burst-extra-middle",
      "leylineHit": "flins.burst.param2-extra",
      "source": "tools/data/sources/genshin-db/8e5badd60b5d894284ccc927a56c9683529d2592/ChineseSimplified/talents/flins.json#combat3",
      "interpretation": "A separately selectable single extra middle strike uses the ordinary burst middle-strike coefficient and requires both full Moonsign and a nearby thundercloud. Two such strikes are described; each query evaluates one strike. All four combinations of the explicit facts are tested. This is not mapped to a Mona output without a verified distinct index."
    },
    {
      "id": "shenhe-quill-to-kaeya",
      "monaInput": { "character": "Kaeya", "level": 1, "ascend": false, "constellation": 0, "skill1": 0, "skill2": 0, "skill3": 0, "weapon": "DullBlade", "weaponLevel": 1, "refine": 1, "artifacts": [], "enemy": null, "skillIndex": 10, "buff": "ShenheE", "buffSkill2": 1, "crit": "non_critical" },
      "leylineInput": { "recipient": "kaeya", "recipientLevel": 1, "recipientWeapon": "dullblade", "owner": "shenhe", "ownerLevel": 1, "ownerWeapon": "beginnersprotector", "talentLevel": 1, "enemyLevel": 90, "cryoResistance": 0.1, "hit": "kaeya.skill.param1", "buff": "shenhe.icy-quill", "fact": "shenhe.quillTap" },
      "equation": "source attack * 0.45656 * 101 / 291 * 0.9, added to the Cryo recipient's noncritical damage",
      "monaRows": [
        { "sourceAttack": 0, "damage": 25.084651546391754 },
        { "sourceAttack": 46.8924, "damage": 31.772851712907215, "addedBase": 21.41106984 },
        { "sourceAttack": 100, "damage": 39.3475175257732, "addedBase": 45.66 }
      ],
      "interpretation": "Mona rounds recipient attack to 42; LeyLine retains source precision. The LeyLine test toggles the source fact and changes the source weapon level from 1 to 20."
    },
    {
      "id": "frostbearer-target-aura",
      "monaRule": ".references/mona-community/beta-data/equipment-damage-events.mjs:56",
      "leylineHits": ["frostbearer.icicle", "frostbearer.icicle-cryo"],
      "monaInput": { "profiles": ["Lisa with R1 Frostbearer", "Kaeya with R1 DullBlade or Amber with R1 DullBlade"], "artifacts": [[], []], "events": [{ "role": 0, "time": 0, "category": "normal", "onField": true, "order": 0, "rootOrder": 0 }], "heals": [], "duration": 2 },
      "monaOutput": [{ "ally": "Kaeya", "ratio": 2, "probability": 0.6 }, { "ally": "Amber", "ratio": 0.8, "probability": 0.6 }],
      "leylineInput": { "character": "lisa", "level": 1, "ascension": 0, "weapon": "frostbearer", "weaponLevel": 1, "refinement": 1, "artifacts": [], "allyElement": "cryo", "enemyLevel": 1, "physicalResistance": 0.1, "triggered": true, "targetCryoAura": [false, true] },
      "equation": "(19.41072 + 42.401) * 1.09 * coefficient * 0.5 * 0.9; coefficient is 0.8 without target Cryo and 2.0 with target Cryo",
      "interpretation": "The Mona rule selects the higher coefficient when a Cryo character is in the profiles. The weapon description instead specifies the target affected by Cryo. With a Cryo ally present, LeyLine tests both target aura values and both branches at R1, using 0.8 and 2.0 attack coefficients respectively."
    },
    {
      "id": "xingqiu-two-strikes",
      "leylineHits": ["xingqiu.skill.param1", "xingqiu.skill.param2"],
      "monaInput": { "character": "Xingqiu", "level": 90, "ascend": false, "constellation": 0, "skill1": 8, "skill2": 8, "skill3": 8, "weapon": "FavoniusSword", "weaponLevel": 90, "refine": 1, "artifacts": [], "enemy": null, "buffs": [], "crit": "non_critical" },
      "monaRows": [{ "index": 15, "normal": 1254.5197056, "vaporize": 2509.0394112 }, { "index": 16, "normal": 1427.76290304, "vaporize": 2855.52580608 }],
      "interpretation": "T9 coefficients 2.856 and 3.2504 are tested independently with and without Hydro-triggered vaporize. Mona rounds its character and weapon white attack before applying the ascension bonus; LeyLine retains source precision."
    }
  ],
