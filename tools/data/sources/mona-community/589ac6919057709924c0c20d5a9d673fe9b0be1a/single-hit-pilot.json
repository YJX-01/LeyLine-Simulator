      "sources": [".references/mona-community/beta-tools/runtime-7106.mjs", "tools/data/sources/genshin-db/8e5badd60b5d894284ccc927a56c9683529d2592/ChineseSimplified/talents/flins.json", "tools/data/sources/genshin-db/8e5badd60b5d894284ccc927a56c9683529d2592/stats/talents.json", "tools/data/sources/kqm-web/2026-11-15/reaction-formulas.json", "tests/unit/mona-single-hit-pilot.test.ts"],
